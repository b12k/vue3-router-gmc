{
  "name": "@b12k/vue3-router-gmc",
  "version": "0.2.1",
  "description": "Vue 3 Router - Get Matched Components",
  "keywords": [],
  "homepage": "https://github.com/b12k/vue3-router-gmc",
  "bugs": {
    "url": "https://github.com/b12k/vue3-router-gmc/issues"
  },
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b12k/vue3-router-gmc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest run",
    "test:watch": "rstest",
    "test:types": "tsc --project test/tsconfig.json",
    "lint": "run-p _lint:*",
    "_lint:types": "tsc --noEmit",
    "_lint:scripts": "oxlint --type-aware --deny-warnings src test *.config.ts",
    "_lint:codestyle": "oxfmt --check .",
    "prepare": "husky",
    "release": "release-it --ci",
    "husky:pre-commit": "run-p _husky:pre-commit:*",
    "_husky:pre-commit:typecheck": "pnpm _lint:types",
    "_husky:pre-commit:lintstaged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@release-it/conventional-changelog": "12.0.2",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "release-it": "21.1.0",
    "typescript": "7.0.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "peerDependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "packageManager": "pnpm@12.9.1"
}
