{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "rootDir": "./src",
    "declarationDir": "./dist",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
